# Variables de auth-service. En Docker Compose ya se inyectan desde
# docker-compose.yml; este archivo es solo referencia (p. ej. para Render).
# Requiere PostgreSQL >= 15.

# Docker Compose (red interna):  postgresql://vetchain:vetchain_dev@postgres:5432/auth_db
# Producción: la cadena de conexión real, cargada como secreto en la plataforma.
DATABASE_URL="postgresql://usuario:password@host:5432/auth_db"
PORT=3001

# true solo en local/demo. En producción: false.
SEED_DEMO_USERS=false
